# Este archivo es solo un ejemplo: editarlo en GitHub NO cambia los Secrets del
# despliegue. Copia el valor deseado en Settings > Secrets de Streamlit.
#
# Este valor se usa inicialmente y como respaldo. Después, únicamente
# roberto.chapman@gobravo.com.co puede cambiarlo desde el botón de la app; el
# estado compartido se guarda en la pestaña "Configuracion App" de Google Sheets.
# true  = nadie necesita la contraseña general.
# false = se exige CALCULATOR_PASSWORD, salvo para los correos exentos.
CALCULATOR_PUBLIC_ACCESS = false

# La clave general nunca habilita automáticamente el modo editor.
CALCULATOR_PASSWORD = "Estructurados*1214"
EDITOR_MODE_PASSWORD = "Estructurados*1214"
